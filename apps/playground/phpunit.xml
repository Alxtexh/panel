<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            THE SUITE DOES NOT WRITE INTO THE DEVELOPMENT LOG.

            Without this, every test that deliberately provokes an exception -
            an unwritable backup destination, a refused restore, a 500 asserted
            on purpose - files its stack trace into the same storage/logs the
            Logs screen reads. It reached 256 MB and 1.5 million lines here,
            which cost two things: the Logs screen showed test failures instead
            of application events, and the file rode into every backup.

            `null` rather than a testing.log, because a second file would grow
            the same way and `LogReader` globs *.log - it would simply move the
            noise onto the same screen under a different name. A test that
            cares what was logged asserts against `Log::spy()`, which does not
            involve a channel at all.
        -->
        <env name="LOG_CHANNEL" value="null"/>
        <!--
            THE SAME BROADCASTER THE APPLICATION USES, set here rather than in a
            test, because `Broadcast::channel()` registers callbacks on whichever
            driver exists at BOOT. Switching the driver inside setUp() builds a
            fresh broadcaster with no channels on it, so every subscription is
            refused and the refusal tests pass for entirely the wrong reason.

            It matches `.env` deliberately. `log` and `null` do not consult the
            callbacks at all — they authorise everything, including guests — so a
            suite testing one driver while the application runs another would be
            proving a guard that never runs in production.
        -->
        <env name="BROADCAST_CONNECTION" value="reverb" force="true"/>
        <env name="REVERB_APP_ID" value="test-app"/>
        <env name="REVERB_APP_KEY" value="test-key"/>
        <env name="REVERB_APP_SECRET" value="test-secret"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
