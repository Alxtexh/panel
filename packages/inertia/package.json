    "vue": "^3.5.0",
    "vue-sonner": "^2.0.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@lucide/vue": "^1.17.0",
    "@panelkit/ui": "file:../ui",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vue": "^3.5.13",
    "vue-sonner": "^2.0.0"
  },
  "scripts": {
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
