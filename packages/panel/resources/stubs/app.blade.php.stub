{{--
    The root view every Inertia response renders into.

    PUBLISHED BY `panel:install` AND YOURS TO EDIT. It is here because a fresh
    application has none, and without one the first panel route answers with
    "View [app] not found" - an error about a file nobody told you to write.

    DEFAULT PATH: published kit CSS/JS at public/vendor/panel. That is why
    `panel:install` after Composer is not a white page. `@vite` is used only
    when you have run `npm run build` and a Vite manifest exists.

    NO `@routes` DIRECTIVE. Ziggy and Wayfinder are both fine and neither is
    required: the packaged screens are given the URLs they need as props, so a
    route helper missing on the client is not a screen that breaks. Add one if
    your own pages want it.
--}}
<!DOCTYPE html>
<html lang="{{ str_replace('_', '-', app()->getLocale()) }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {{--
            APPEARANCE, APPLIED BEFORE THE FIRST PAINT.

            The account's saved theme is embedded for the pre-paint script and
            for `bootstrapAppearance()` in app.ts. localStorage alone cannot
            carry a preference across browsers; the server value is the source
            of truth once somebody is signed in.
        --}}
        <script>
            window.__panelAppearance = @json(auth()->user()?->appearance);
        </script>

        <script>
            (function () {
                try {
                    var server = window.__panelAppearance;
                    var raw = localStorage.getItem('alxtexhpanel.appearance.vars');

                    if (raw) {
                        var cached = JSON.parse(raw);
                        var root = document.documentElement;
                        var stale = server && server.theme && cached.theme && server.theme !== cached.theme;

                        if (stale) {
                            root.classList.toggle('dark', server.theme === 'dark');

                            if (server.fontSize) {
                                root.style.setProperty('--pk-font-size', server.fontSize + 'px');
                            }

                            return;
                        }

                        if (cached.dark) root.classList.add('dark');
                        else root.classList.remove('dark');

                        for (var name in cached.vars) {
                            root.style.setProperty(name, cached.vars[name]);
                        }

                        return;
                    }

                    if (server && server.theme) {
                        document.documentElement.classList.toggle('dark', server.theme === 'dark');

                        if (server.fontSize) {
                            document.documentElement.style.setProperty('--pk-font-size', server.fontSize + 'px');
                        }

                        return;
                    }
                } catch (e) {
                    // Fall through to light below.
                }

                document.documentElement.classList.remove('dark');
            })();
        </script>

        <style>
            html {
                background-color: oklch(1 0 0);
            }

            html.dark {
                background-color: oklch(0.145 0 0);
            }
        </style>

        <title inertia>{{ config('app.name', 'Panel') }}</title>

        @if (\Alxtexh\Panel\Support\KitAssets::hostViteManifestExists())
            @vite(['resources/js/app.ts'])
        @else
            @php(\Alxtexh\Panel\Support\KitAssets::publishIfMissing())
            <link rel="stylesheet" href="{{ asset('vendor/panel/app.css') }}">
            <script type="module" src="{{ asset('vendor/panel/app.js') }}"></script>
        @endif
        @inertiaHead
    </head>

    <body class="font-sans antialiased">
        @inertia
    </body>
</html>
