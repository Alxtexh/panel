/**
 * The Inertia bootstrap.
 *
 * PUBLISHED BY `panel:install` AND YOURS TO EDIT. It is here because a fresh
 * application has none, and `panel:install` used to write page files and then
 * tell you to bring a starter kit - so nothing rendered until three files
 * nobody named had been written by hand, differently, in every install.
 *
 * WHAT THE THREE PIECES DO:
 *
 *   `resolve`  turns a page NAME the server sent - "ResourceIndex",
 *              "panel/auth/Login" - into a component, by globbing this directory.
 *              That glob is the reason a packaged screen still needs a
 *              one-line file here: Vite cannot see into node_modules.
 *
 *   `setup`    mounts Vue and installs the layout, so a screen that declares
 *              none still gets the panel chrome.
 *
 *   `progress` the loading bar. Off by default in Inertia; a panel without one
 *              looks frozen on any request slower than instant.
 */
import { createInertiaApp } from '@inertiajs/vue3'
import { initializeAppearance } from '@alxtexh-enterprise/panel'
import { createApp, h } from 'vue'
import type { DefineComponent } from 'vue'
import PanelLayout from './layouts/PanelLayout.vue'
import '../css/app.css'

/*
 * LIGHT OR DARK, BEFORE THE FIRST SCREEN. Reads the same cookie the root view
 * does, so the class the server rendered and the one the client would choose
 * agree - which is what stops the theme flickering on a full page load.
 */
initializeAppearance()

createInertiaApp({
    title: (title) => (title ? `${title} — ${import.meta.env.VITE_APP_NAME ?? 'Panel'}` : String(import.meta.env.VITE_APP_NAME ?? 'Panel')),

    resolve: (name) => {
        const pages = import.meta.glob<DefineComponent>('./pages/**/*.vue', { eager: true })
        const page = pages[`./pages/${name}.vue`]

        if (!page) {
            /*
             * A NAMED FAILURE, because the default is a blank screen and a
             * console message about `undefined`. The usual cause is a packaged
             * screen with no file here - `php artisan panel:update` writes the
             * ones a new version added.
             */
            throw new Error(
                `Inertia page [${name}] has no file at resources/js/pages/${name}.vue. ` +
                    'If it is a packaged screen, run `php artisan panel:update`.',
            )
        }

        /*
         * THE LAYOUT IS APPLIED HERE unless the screen chose its own.
         *
         * AUTH LIVES AT `panel/auth/*`, NOT `auth/*`. The package deliberately
         * moved off `auth/Login` so it would not collide with Breeze/Jetstream.
         * Matching only `auth/` therefore wrapped every packaged sign-in in the
         * panel shell - sidebar, search, notifications - around a form nobody
         * can use yet. That is the "install looks broken / design changed"
         * failure on a fresh app.
         *
         * Landing and error pages also draw their own chrome: a guest has no
         * panel to be inside, and an unmatched URL never starts a session.
         */
        const standalone =
            name.startsWith('panel/auth/') ||
            name.startsWith('auth/') ||
            name.startsWith('landing/') ||
            name.startsWith('errors/')

        page.default.layout ??= standalone ? undefined : PanelLayout

        return page
    },

    setup({ el, App, props, plugin }) {
        createApp({ render: () => h(App, props) })
            .use(plugin)
            .mount(el)
    },

    progress: { color: '#4B5563' },
})
