{
    "name": "@panelkit/ui",
    "version": "0.7.2",
    "description": "Vue 3 rendering layer for PanelKit. Framework-agnostic: no Inertia import anywhere in this package.",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "vue": "^3.5.0",
        "@laravel/passkeys": "^0.2.0"
    },
    "dependencies": {
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0"
    },
    "devDependencies": {
        "@laravel/passkeys": "^0.2.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^25.0.1",
        "prettier": "^3.9.6",
        "typescript": "^5.7.0",
        "vite": "^7.0.0",
        "vitest": "^3.2.7",
        "vue": "^3.5.13",
        "vue-tsc": "^2.2.0"
    },
    "scripts": {
        "test": "vitest run",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "build": "vite build && vue-tsc -p tsconfig.build.json",
        "prepack": "npm run build"
    },
    "peerDependenciesMeta": {
        "@laravel/passkeys": {
            "optional": true
        }
    }
}
