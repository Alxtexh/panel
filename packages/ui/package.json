{
    "name": "@alxtexh-enterprise/panel",
    "version": "1.0.68",
    "description": "The client half: the Vue rendering layer and the Inertia screens. Import from \".\" for components that name no transport, \"./inertia\" for the screens.",
    "type": "module",
    "license": "MIT",
    "author": "Alxtexh",
    "homepage": "https://github.com/Alxtexh/panelkit#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Alxtexh/panelkit.git",
        "directory": "packages/ui"
    },
    "bugs": {
        "url": "https://github.com/Alxtexh/panelkit/issues"
    },
    "keywords": [
        "laravel",
        "inertia",
        "vue",
        "admin-panel",
        "dashboard",
        "alxtexhpanel"
    ],
    "private": true,
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./inertia": "./inertia/index.ts",
        "./pages/*": "./inertia/pages/*",
        "./components/*": "./inertia/components/*",
        "./composables/*": "./inertia/composables/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "inertia",
        "!inertia/**/*.spec.ts"
    ],
    "peerDependencies": {
        "@inertiajs/vue3": "^2.0.0 || ^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "vue": "^3.5.0",
        "vue-sonner": "^2.0.0"
    },
    "dependencies": {
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^25.0.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.0",
        "vite": "^7.0.0",
        "vitest": "^3.2.7",
        "vue": "^3.5.13",
        "vue-sonner": "^2.0.0",
        "vue-tsc": "^2.2.0"
    },
    "scripts": {
        "test": "vitest run",
        "lint": "../../apps/playground/node_modules/.bin/eslint . --fix",
        "lint:check": "../../apps/playground/node_modules/.bin/eslint .",
        "format": "prettier --write src/ inertia/",
        "format:check": "prettier --check src/ inertia/",
        "build": "vite build && vue-tsc -p tsconfig.build.json && vite build --config vite.kit.config.ts",
        "build:kit": "vite build --config vite.kit.config.ts",
        "prepack": "npm run build"
    },
    "peerDependenciesMeta": {
        "@laravel/passkeys": {
            "optional": true
        }
    }
}
