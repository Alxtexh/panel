{
    "name": "@panelkit/ui",
    "version": "0.6.2",
    "description": "Vue 3 rendering layer for PanelKit. Framework-agnostic: no Inertia import anywhere in this package.",
    "type": "module",
    "license": "MIT",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./theme/tokens.css": "./src/theme/tokens.css"
    },
    "files": [
        "src"
    ],
    "peerDependencies": {
        "vue": "^3.5.0",
        "@laravel/passkeys": "^0.2.0"
    },
    "dependencies": {
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^25.0.1",
        "prettier": "^3.9.6",
        "typescript": "^5.7.0",
        "vitest": "^3.2.7",
        "vue": "^3.5.13",
        "@laravel/passkeys": "^0.2.0"
    },
    "scripts": {
        "test": "vitest run",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/"
    },
    "peerDependenciesMeta": {
        "@laravel/passkeys": {
            "optional": true
        }
    }
}
